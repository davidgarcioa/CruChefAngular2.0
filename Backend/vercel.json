{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/voice.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/voice/(.*)",
      "dest": "/api/voice.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
