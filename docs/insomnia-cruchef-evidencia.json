      "method": "GET",
      "url": "{{ base_url }}/owner/restaurants/{{ temp_restaurant_id }}/dishes",
      "description": "Debe responder 200 mostrando el plato temporal creado.",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ id_token }}"
        }
      ]
    },
    {
      "_id": "req_ev_10_update_dish",
      "_type": "request",
      "parentId": "fld_ev_owner",
      "name": "Evidencia 10 - PUT Update Dish 200",
      "method": "PUT",
      "url": "{{ base_url }}/owner/restaurants/{{ temp_restaurant_id }}/dishes/{{ temp_dish_id }}",
      "description": "Actualiza nombre, precio y categoria del plato temporal.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Plato Evidencia Insomnia Editado\",\n  \"price\": 26500,\n  \"categoryId\": \"tacos\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ id_token }}"
        }
      ]
    },
    {
      "_id": "req_ev_11_delete_dish",
      "_type": "request",
      "parentId": "fld_ev_owner",
