    {
      "_id": "req_ev_signin",
      "_type": "request",
      "parentId": "fld_ev_auth",
      "name": "Paso 01 - Obtener id_token",
      "method": "POST",
      "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{ firebase_api_key }}",
      "description": "Ejecuta este request, luego copia el campo idToken del response y pegalo en la variable id_token del environment.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ email }}\",\n  \"password\": \"{{ password }}\",\n  \"returnSecureToken\": true\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "_id": "req_ev_01_health",
      "_type": "request",
      "parentId": "fld_ev_public",
      "name": "Evidencia 01 - GET Health 200",
      "method": "GET",
      "url": "{{ base_url }}/health",
      "description": "Captura sugerida: status 200 y body con ok=true.",
      "headers": []
    },
    {
      "_id": "req_ev_02_public_restaurants",
      "_type": "request",
      "parentId": "fld_ev_public",
      "name": "Evidencia 02 - GET Public Restaurants 200",
      "method": "GET",
      "url": "{{ base_url }}/public/restaurants",
      "description": "Captura sugerida: lista publica de restaurantes.",
      "headers": []
    },
    {
      "_id": "req_ev_03_public_dishes",
      "_type": "request",
      "parentId": "fld_ev_public",
      "name": "Evidencia 03 - GET Public Dishes 200",
      "method": "GET",
      "url": "{{ base_url }}/public/restaurants/{{ owner_uid }}/{{ restaurant_id }}/dishes",
      "description": "Captura sugerida: lista publica de platos del restaurante seleccionado.",
      "headers": []
    },
    {
      "_id": "req_ev_04_owner_no_token",
      "_type": "request",
      "parentId": "fld_ev_owner",
      "name": "Evidencia 04 - GET Owner Restaurants 401 Sin Token",
      "method": "GET",
      "url": "{{ base_url }}/owner/restaurants",
      "description": "Debe responder 401. Sirve para evidenciar proteccion por autenticacion.",
      "headers": []
    },
    {
      "_id": "req_ev_05_owner_ok",
      "_type": "request",
      "parentId": "fld_ev_owner",
      "name": "Evidencia 05 - GET Owner Restaurants 200 Con Token",
      "method": "GET",
      "url": "{{ base_url }}/owner/restaurants",
      "description": "Debe responder 200 usando Authorization Bearer {{ id_token }}.",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ id_token }}"
        }
      ]
    },
    {
      "_id": "req_ev_06_create_restaurant",
      "_type": "request",
      "parentId": "fld_ev_owner",
      "name": "Evidencia 06 - POST Create Restaurant 201",
      "method": "POST",
      "url": "{{ base_url }}/owner/restaurants",
      "description": "Crea un restaurante temporal. Copia el id del response y pegalo en temp_restaurant_id.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Restaurante Evidencia Insomnia\",\n  \"address\": \"Calle 10 # 20-30\",\n  \"city\": \"Bogota\",\n  \"phone\": \"3001234567\",\n  \"schedule\": \"Lun - Vie 8:00 - 18:00\",\n  \"rut\": \"900123456-7\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ id_token }}"
        }
      ]
    },
    {
      "_id": "req_ev_07_get_empty_dishes",
      "_type": "request",
      "parentId": "fld_ev_owner",
      "name": "Evidencia 07 - GET Owner Dishes 200 Vacio",
      "method": "GET",
      "url": "{{ base_url }}/owner/restaurants/{{ temp_restaurant_id }}/dishes",
      "description": "Debe responder 200 con arreglo vacio justo despues de crear el restaurante temporal.",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ id_token }}"
        }
      ]
    },
    {
      "_id": "req_ev_08_create_dish",
      "_type": "request",
      "parentId": "fld_ev_owner",
      "name": "Evidencia 08 - POST Create Dish 201",
