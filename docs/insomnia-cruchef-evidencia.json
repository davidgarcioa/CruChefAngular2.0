      "url": "{{ base_url }}/owner/restaurants/{{ temp_restaurant_id }}/dishes",
      "description": "Crea un plato temporal. Copia el id del response y pegalo en temp_dish_id.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Plato Evidencia Insomnia\",\n  \"price\": 25500,\n  \"categoryId\": \"pizza\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
